<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDisplayName</key>
	<string>Forklore</string>
	<key>NSCameraUsageDescription</key>
	<string>So you can video call a nutritionist.</string>
	<key>NSHealthShareUsageDescription</key>
	<string>Forklore reads your steps, sleep, heart rate and glucose so meal ideas fit your day.</string>
	<key>NSMicrophoneUsageDescription</key>
	<string>So you can talk to the assistant and join video calls with a nutritionist.</string>
	<key>NSSpeechRecognitionUsageDescription</key>
	<string>So you can talk to the assistant instead of typing.</string>
	<key>UIAppFonts</key>
	<array>
		<string>EBGaramond.ttf</string>
		<string>EBGaramond-Italic.ttf</string>
		<string>Jost-Regular.ttf</string>
		<string>Jost-Medium.ttf</string>
	</array>
	<key>UILaunchScreen</key>
	<dict>
		<key>UIColorName</key>
		<string>LaunchBackground</string>
	</dict>
</dict>
</plist>
