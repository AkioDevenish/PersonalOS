{
  "expo": {
    "name": "Personal OS",
    "slug": "personal-os",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "scheme": "personalos",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.personalos.app",
      "infoPlist": {
        "NSHealthShareUsageDescription": "Personal OS reads your health data to build your daily briefing. It is never shared, and never written back to Health.",
        "NSHealthUpdateUsageDescription": "Personal OS does not write to Health.",
        "UIBackgroundModes": [
          "fetch",
          "processing"
        ]
      },
      "entitlements": {
        "com.apple.developer.healthkit": true,
        "com.apple.developer.healthkit.background-delivery": true
      }
    },
    "android": {
      "package": "com.personalos.app",
      "adaptiveIcon": {
        "backgroundColor": "#F2EDE3",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.health.READ_STEPS",
        "android.permission.health.READ_DISTANCE",
        "android.permission.health.READ_FLOORS_CLIMBED",
        "android.permission.health.READ_ACTIVE_CALORIES_BURNED",
        "android.permission.health.READ_TOTAL_CALORIES_BURNED",
        "android.permission.health.READ_SLEEP",
        "android.permission.health.READ_HEART_RATE",
        "android.permission.health.READ_RESTING_HEART_RATE",
        "android.permission.health.READ_HEART_RATE_VARIABILITY",
        "android.permission.health.READ_OXYGEN_SATURATION",
        "android.permission.health.READ_RESPIRATORY_RATE",
        "android.permission.health.READ_WEIGHT",
        "android.permission.health.READ_BLOOD_GLUCOSE",
        "android.permission.health.READ_HEALTH_DATA_IN_BACKGROUND"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "extra": {
      "apiBaseUrl": "https://web-iota-eight-97.vercel.app"
    },
    "plugins": [
      "expo-secure-store"
    ]
  }
}
